// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  password  String
  name      String
  role      Role            @default(USER)
  avatarUrl String?         @db.Text
  reviews   Review[]
  views     ViewHistory[]
  watchlist Watchlist[]
  clicks    ProviderClick[]
  createdAt DateTime        @default(now())
}

enum Role {
  USER
  ADMIN
}

enum EditStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Movie {
  id             String          @id @default(cuid())
  tmdbId         Int             @unique
  title          String
  overview       String
  posterPath     String?
  releaseYear    Int?
  voteAverage    Float?
  genres         String[]
  tags           String[]
  watchProviders String[]        // Format: "ProviderName|https://link.com"
  trailerKey     String?
  director       String?
  cast           String[]
  reviews        Review[]
  views          ViewHistory[]
  watchlist      Watchlist[]
  providerClicks ProviderClick[]
}

model Review {
  id               String     @id @default(cuid())
  content          String
  rating           Int
  pendingContent   String?
  pendingRating    Int?
  editStatus       EditStatus @default(NONE)
  editRequestedAt DateTime?
  user             User       @relation(fields: [userId], references: [id])
  userId           String
  movie            Movie      @relation(fields: [movieId], references: [id])
  movieId          String
  createdAt        DateTime   @default(now())
}

model ViewHistory {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String
  viewCount Int      @default(1)
  viewedAt  DateTime @default(now())

  @@unique([userId, movieId])
  @@index([userId, viewedAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
  @@index([userId])
}

model ProviderClick {
  id           String   @id @default(cuid())
  providerName String
  movie        Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId      String
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  createdAt    DateTime @default(now())

  @@index([providerName])
  @@index([movieId])
}