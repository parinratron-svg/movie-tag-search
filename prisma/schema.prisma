// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  password  String
  name      String
  role      Role            @default(USER)
  avatarUrl String?         @db.Text
  reviews   Review[]
  views     ViewHistory[]
  watchlist Watchlist[]
  clicks    ProviderClick[]
  favorites Favorite[]
  posts     Post[]
  postLikes PostLike[]
  comments  Comment[]
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum EditStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Movie {
  id             String          @id @default(cuid())
  tmdbId         Int             @unique
  title          String
  overview       String
  posterPath     String?
  releaseYear    Int?
  voteAverage    Float?
  genres         String[]
  tags           String[]
  watchProviders String[]        // Format: "ProviderName|https://link.com"
  trailerKey     String?
  director       String?
  cast           String[]
  reviews        Review[]
  views          ViewHistory[]
  watchlist      Watchlist[]
  providerClicks ProviderClick[]
  watchLinks     WatchLink[]
  favorites      Favorite[]
  posts          Post[]
}

model WatchLink {
  id       String @id @default(cuid())
  platform String
  url      String
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId  String

  @@index([movieId])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
}

model Review {
  id               String     @id @default(cuid())
  content          String
  rating           Int
  pendingContent   String?
  pendingRating    Int?
  editStatus       EditStatus @default(NONE)
  editRequestedAt  DateTime?
  user             User       @relation(fields: [userId], references: [id])
  userId           String
  movie            Movie      @relation(fields: [movieId], references: [id])
  movieId          String
  createdAt        DateTime   @default(now())
}

model ViewHistory {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String
  viewCount Int      @default(1)
  viewedAt  DateTime @default(now())

  @@unique([userId, movieId])
  @@index([userId, viewedAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
  @@index([userId])
}

model ProviderClick {
  id           String   @id @default(cuid())
  providerName String
  movie        Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId      String
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  createdAt    DateTime @default(now())

  @@index([providerName])
  @@index([movieId])
}

model Post {
  id        String     @id @default(cuid())
  title     String
  content   String     @db.Text
  tags      String[]   @default([])
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  movie     Movie?     @relation(fields: [movieId], references: [id], onDelete: SetNull)
  movieId   String?
  likes     PostLike[]
  comments  Comment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([movieId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}